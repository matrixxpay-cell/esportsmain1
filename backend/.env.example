# ============================================================
# IndiaEsports Backend — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

NODE_ENV=production
PORT=5000

# ── Database ─────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/indiaesports
# OR Atlas: MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/indiaesports

# ── JWT Auth ─────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# ── Frontend URL (no trailing slash) ─────────────────────────
FRONTEND_URL=http://YOUR_VPS_IP

# ── Email (Gmail App Password recommended) ───────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=IndiaEsports <noreply@indiaesports.gg>

# ── Razorpay ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── OpenAI (AI features) ─────────────────────────────────────
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXX

# ── Admin Seed ────────────────────────────────────────────────
ADMIN_EMAIL=admin@indiaesports.gg
ADMIN_PASSWORD=StrongAdminPassword123!
